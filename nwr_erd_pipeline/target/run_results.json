rows_affected": 1, "bytes_processed": 357000, "bytes_billed": 20971520, "location": "US", "project_id": "nwr-data-platform", "job_id": "2bcbbc74-392b-4493-b7cc-021341ccd353", "slot_ms": 316}, "message": null, "failures": 0, "unique_id": "test.nwr_erd_pipeline.relationships_fct_ratings_player_sk__player_sk__ref_dim_players_.c5d07be833", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select player_sk as from_field\n    from `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\n    where player_sk is not null\n),\n\nparent as (\n    select player_sk as to_field\n    from `nwr-data-platform`.`dbt_erd_nwr`.`dim_players`\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-15T11:39:10.501092Z", "completed_at": "2026-10-15T11:39:10.512795Z"}, {"name": "execute", "started_at": "2026-10-15T11:39:10.515301Z", "completed_at": "2026-10-15T11:39:14.645813Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 4.150775194168091, "adapter_response": {"_message": "SELECT (1.0 rows, 78.1 KiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 80000, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "5269ae89-7286-4974-b483-0813759969b8", "slot_ms": 468}, "message": null, "failures": 0, "unique_id": "test.nwr_erd_pipeline.unique_fct_ratings_cms_rating_id.10a3358687", "compiled": true, "compiled_code": "\n    \n    \n\nwith dbt_test__target as (\n\n  select cms_rating_id as unique_field\n  from `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\n  where cms_rating_id is not null\n\n)\n\nselect\n    unique_field,\n    count(*) as n_records\n\nfrom dbt_test__target\ngroup by unique_field\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-15T11:39:14.670377Z", "completed_at": "2026-10-15T11:39:14.683639Z"}, {"name": "execute", "started_at": "2026-10-15T11:39:14.685654Z", "completed_at": "2026-10-15T11:39:21.127653Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 6.469022750854492, "adapter_response": {"_message": "CREATE TABLE (9.1k rows, 566.4 KiB processed)", "code": "CREATE TABLE", "rows_affected": 9054, "bytes_processed": 580000, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "d28c6451-99ed-4141-b29e-4a832e1abc5d", "slot_ms": 25801}, "message": "CREATE TABLE (9.1k rows, 566.4 KiB processed)", "failures": null, "unique_id": "model.nwr_erd_pipeline.fct_daily_player_kpi", "compiled": true, "compiled_code": "\n\nWITH daily_aggregates AS (\n    SELECT\n        EXTRACT(DATE FROM rating_ts) AS date_day,\n        player_sk,\n        SUM(coin_in) AS daily_coin_in,\n        SUM(theo_amount) AS daily_theo\n    FROM `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\n    WHERE player_sk IS NOT NULL\n    GROUP BY 1, 2\n),\n\nrolling_metrics AS (\n    SELECT\n        date_day,\n        player_sk,\n        daily_coin_in,\n        daily_theo,\n        -- BigQuery optimized rolling 30-day sum using UNIX_DATE\n        SUM(daily_theo) OVER (\n            PARTITION BY player_sk\n            ORDER BY UNIX_DATE(date_day)\n            RANGE BETWEEN 29 PRECEDING AND CURRENT ROW\n        ) AS rolling_30d_theo\n    FROM daily_aggregates\n)\n\nSELECT\n    date_day,\n    player_sk,\n    daily_coin_in,\n    daily_theo,\n    rolling_30d_theo,\n    -- Player is considered \"Active\" if they generated theo in the last 30 days\n    IF(rolling_30d_theo > 0, TRUE, FALSE) AS is_active_flag\nFROM rolling_metrics", "relation_name": "`nwr-data-platform`.`dbt_erd_nwr`.`fct_daily_player_kpi`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-15T11:39:21.159929Z", "completed_at": "2026-10-15T11:39:21.174447Z"}, {"name": "execute", "started_at": "2026-10-15T11:39:21.176773Z", "completed_at": "2026-10-15T11:39:27.749029Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 6.600074052810669, "adapter_response": {"_message": "CREATE TABLE (92.0 rows, 450.9 KiB processed)", "code": "CREATE TABLE", "rows_affected": 92, "bytes_processed": 461754, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "f248fc7d-1582-43cc-8826-928b9597156c", "slot_ms": 2874}, "message": "CREATE TABLE (92.0 rows, 450.9 KiB processed)", "failures": null, "unique_id": "model.nwr_erd_pipeline.mart_exec_daily", "compiled": true, "compiled_code": "WITH daily_kpi AS (\n    SELECT * FROM `nwr-data-platform`.`dbt_erd_nwr`.`fct_daily_player_kpi`\n),\n\ndaily_summary AS (\n    SELECT\n        date_day AS run_date,\n        SUM(daily_theo) AS kpi_theo_today,\n        COUNT(DISTINCT IF(is_active_flag, player_sk, NULL)) AS kpi_active_players\n    FROM daily_kpi\n    GROUP BY 1\n)\n\nSELECT\n    run_date,\n    kpi_theo_today,\n    -- Month-to-date calculation using window functions\n    SUM(kpi_theo_today) OVER (\n        PARTITION BY EXTRACT(YEAR FROM run_date), EXTRACT(MONTH FROM run_date)\n        ORDER BY run_date\n    ) AS kpi_theo_mtd,\n    kpi_active_players\nFROM daily_summary", "relation_name": "`nwr-data-platform`.`dbt_erd_nwr`.`mart_exec_daily`", "batch_results": null}], "elapsed_time": 32.705881118774414, "args": {"printer_width": 80, "favor_state": false, "project_dir": "D:\\dev\\nwr_erd_analytics\\nwr_erd_pipeline", "require_batched_execution_for_custom_microbatch_strategy": false, "require_all_warnings_handled_by_warn_error": false, "require_yaml_configuration_for_mf_time_spines": false, "require_ref_searches_node_package_before_root": false, "require_resource_names_without_spaces": true, "state_modified_compare_more_unrendered_values": false, "log_level_file": "debug", "static_parser": true, "require_nested_cumulative_type_params": false, "which": "build"
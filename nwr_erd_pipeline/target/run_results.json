wr-data-platform`.`dbt_erd_nwr`.`fct_ratings`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-15T11:33:53.941962Z", "completed_at": "2026-10-15T11:33:53.981992Z"}, {"name": "execute", "started_at": "2026-10-15T11:33:53.989344Z", "completed_at": "2026-10-15T11:34:00.555163Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 6.6201841831207275, "adapter_response": {"_message": "CREATE TABLE (500.0 rows, 27.7 KiB processed)", "code": "CREATE TABLE", "rows_affected": 500, "bytes_processed": 28394, "bytes_billed": 20971520, "location": "US", "project_id": "nwr-data-platform", "job_id": "f14a5f8a-cf4e-45a4-a2ba-556cbf7969f7", "slot_ms": 3658}, "message": "CREATE TABLE (500.0 rows, 27.7 KiB processed)", "failures": null, "unique_id": "model.nwr_erd_pipeline.dim_players", "compiled": true, "compiled_code": "\n\nWITH loyalty AS (\n    SELECT\n        member_no,\n        tier,\n        dob,\n        enroll_date\n    FROM `nwr-data-platform`.`casino_platform`.`bronze_loyalty_members`\n),\n\nxref AS (\n    SELECT\n        member_no,\n        cms_player_id\n    FROM `nwr-data-platform`.`casino_platform`.`bronze_loyalty_cms_xref`\n)\n\nSELECT\n    -- Generate an MD5 string surrogate key using the dbt_utils macro\n    to_hex(md5(cast(coalesce(cast(l.member_no as string), '_dbt_utils_surrogate_key_null_') as string))) AS player_sk,\n    x.cms_player_id,\n    l.member_no,\n    l.tier,\n    l.dob,\n    l.enroll_date,\n    CURRENT_TIMESTAMP() AS dbt_updated_at\nFROM loyalty l\nLEFT JOIN xref x\n    ON l.member_no = x.member_no", "relation_name": "`nwr-data-platform`.`dbt_erd_nwr`.`dim_players`", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-15T11:34:00.166964Z", "completed_at": "2026-10-15T11:34:00.200825Z"}, {"name": "execute", "started_at": "2026-10-15T11:34:00.203841Z", "completed_at": "2026-10-15T11:34:04.251474Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 4.09
e": "compile", "started_at": "2026-10-15T11:34:07.953135Z", "completed_at": "2026-10-15T11:34:07.961129Z"}, {"name": "execute", "started_at": "2026-10-15T11:34:07.964949Z", "completed_at": "2026-10-15T11:34:15.485389Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 7.539258718490601, "adapter_response": {"_message": "CREATE TABLE (9.1k rows, 566.4 KiB processed)", "code": "CREATE TABLE", "rows_affected": 9054, "bytes_processed": 580000, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "831cf6d6-e3d6-4989-8857-af847d265fb8", "slot_ms": 24914}, "message": "CREATE TABLE (9.1k rows, 566.4 KiB processed)", "failures": null, "unique_id": "model.nwr_erd_pipeline.fct_daily_player_kpi", "compiled": true, "compiled_code": "\n\nWITH daily_aggregates AS (\n    SELECT\n        EXTRACT(DATE FROM rating_ts) AS date_day,\n        player_sk,\n        SUM(coin_in) AS daily_coin_in,\n        SUM(theo_amount) AS daily_theo\n    FROM `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\n    WHERE player_sk IS NOT NULL\n    GROUP BY 1, 2\n),\n\nrolling_metrics AS (\n    SELECT\n        date_day,\n        player_sk,\n        daily_coin_in,\n        daily_theo,\n        -- BigQuery optimized rolling 30-day sum using UNIX_DATE\n        SUM(daily_theo) OVER (\n            PARTITION BY player_sk\n            ORDER BY UNIX_DATE(date_day)\n            RANGE BETWEEN 29 PRECEDING AND CURRENT ROW\n        ) AS rolling_30d_theo\n    FROM daily_aggregates\n)\n\nSELECT\n    date_day,\n    player_sk,\n    daily_coin_in,\n    daily_theo,\n    rolling_30d_theo,\n    -- Player is considered \"Active\" if they generated theo in the last 30 days\n    IF(rolling_30d_theo > 0, TRUE, FALSE) AS is_active_flag\nFROM rolling_metrics", "relation_name": "`nwr-data-platform`.`dbt_erd_nwr`.`fct_daily_player_kpi`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-15T11:34:15.505830Z", "completed_at": "2026-10-15T11:34:15.521493Z"}, {"name": "execute", "started_at": "2026-10-15T11:34:15.523526Z", "completed_at": "2026-10-15T11:34:21.077353Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 5.579519271850586, "adapter_response": {"_message": "CREATE TABLE (92.0 rows, 450.9 KiB processed)", "code": "CREATE TABLE", "rows_affected": 92, "bytes_processed": 461754, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "f501cb3d-7c77-4d75-9bd8-08f164049d0e", "slot_ms": 2956}, "message": "CREATE TABLE (92.0 rows, 450.9 KiB processed)", "failures": null, "unique_id": "model.nwr_erd_pipeline.mart_exec_daily", "compiled": true, "compiled_code": "WITH daily_kpi AS (\n    SELECT * FROM `nwr-data-platform`.`dbt_erd_nwr`.`fct_daily_player_kpi`\n),\n\ndaily_summary AS (\n    SELECT\n        date_day AS run_date,\n        SUM(daily_theo) AS kpi_theo_today,\n        COUNT(DISTINCT IF(is_active_flag, player_sk, NULL)) AS kpi_active_players\n    FROM daily_kpi\n    GROUP BY 1\n)\n\nSELECT\n    run_date,\n    kpi_theo_today,\n    -- Month-to-date calculation using window functions\n    SUM(kpi_theo_today) OVER (\n        PARTITION BY EXTRACT(YEAR FROM run_date), EXTRACT(MONTH FROM run_date)\n        ORDER BY run_date\n    ) AS kpi_theo_mtd,\n    kpi_active_players\nFROM daily_summary", "relation_name": "`nwr-data-platform`.`dbt_erd_nwr`.`mart_exec_daily`", "batch_results": null}], "elapsed_time": 31.663310766220093, "args": {"vars": {}, "log_level": "info", "macro_debugging": false, "favor_state": false, "log_path": "D:\\dev\\nwr_erd_analytics\\nwr_erd_pipeline\\logs", "log_level_file": "debug", "show": false, "require_explicit_package_overrides_for_builtin_materializations": true, "log_file_max_bytes": 10485760, "select": [], "empty": false, "version_check": true, "which": "build", "state_modified_compare_more_unrendered_values": false, "invocation_command": "dbt build", "exclude_resource_types": [], "validate_macro_args": false, "require_resource_names_without_spac
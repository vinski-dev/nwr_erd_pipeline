"bytes_processed": 80000, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "e5ff586b-d897-4496-a400-fdf088f4e7f7", "slot_ms": 502}, "message": null, "failures": 0, "unique_id": "test.nwr_erd_pipeline.unique_fct_ratings_cms_rating_id.10a3358687", "compiled": true, "compiled_code": "\n    \n    \n\nwith dbt_test__target as (\n\n  select cms_rating_id as unique_field\n  from `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\n  where cms_rating_id is not null\n\n)\n\nselect\n    unique_field,\n    count(*) as n_records\n\nfrom dbt_test__target\ngroup by unique_field\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-15T11:34:04.628159Z", "completed_at": "2026-10-15T11:34:04.637928Z"}, {"name": "execute", "started_at": "2026-10-15T11:34:04.639925Z", "completed_at": "2026-10-15T11:34:08.501252Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 3.878124952316284, "adapter_response": {"_message": "SELECT (1.0 rows, 348.6 KiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 357000, "bytes_billed": 20971520, "location": "US", "project_id": "nwr-data-platform", "job_id": "1cf1ced8-cba3-4617-a3b1-429f1aae0743", "slot_ms": 607}, "message": null, "failures": 0, "unique_id": "test.nwr_erd_pipeline.relationships_fct_ratings_player_sk__player_sk__ref_dim_players_.c5d07be833", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select player_sk as from_field\n    from `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\n    where player_sk is not null\n),\n\nparent as (\n    select player_sk as to_field\n    from `nwr-data-platform`.`dbt_erd_nwr`.`dim_players`\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_
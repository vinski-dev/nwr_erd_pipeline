": "SELECT", "rows_affected": 1, "bytes_processed": 357000, "bytes_billed": 20971520, "location": "US", "project_id": "nwr-data-platform", "job_id": "98c132bc-3ce6-4428-92a3-1c418393066e", "slot_ms": 271}, "message": null, "failures": 0, "unique_id": "test.nwr_erd_pipeline.relationships_fct_ratings_player_sk__player_sk__ref_dim_players_.c5d07be833", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select player_sk as from_field\n    from `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\n    where player_sk is not null\n),\n\nparent as (\n    select player_sk as to_field\n    from `nwr-data-platform`.`dbt_erd_nwr`.`dim_players`\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-14T15:48:41.309835Z", "completed_at": "2026-10-14T15:48:41.333795Z"}, {"name": "execute", "started_at": "2026-10-14T15:48:41.337218Z", "completed_at": "2026-10-14T15:48:47.343349Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 6.054052114486694, "adapter_response": {"_message": "SELECT (1.0 rows, 16.6 KiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 17000, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "ca439999-0d0d-4346-ab0e-702d9bc661f8", "slot_ms": 5}, "message": null, "failures": 0, "unique_id": "test.nwr_erd_pipeline.unique_dim_players_player_sk.6224652398", "compiled": true, "compiled_code": "\n    \n    \n\nwith dbt_test__target as (\n\n  select player_sk as unique_field\n  from `nwr-data-platform`.`dbt_erd_nwr`.`dim_players`\n  where player_sk is not null\n\n)\n\nselect\n    unique_field,\n    count(*) as n_records\n\nfrom dbt_test__target\ngroup by unique_field\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-14T15:48:41.699579Z", "completed_at": "2026-10-14T15:48:41.710017Z"}, {"name": "execute", "started_at": "2026-10-14T15:48:41.714015Z", "completed_at": "2026-10-14T15:48:51.395437Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 9.699144124984741, "adapter_response": {"_message": "CREATE TABLE (9.1k rows, 566.4 KiB processed)", "code": "CREATE TABLE", "rows_affected": 9054, "bytes_processed": 580000, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "259b0e21-d2c7-4459-869c-ed4cb83d8a46", "slot_ms": 27591}, "message": "CREATE TABLE (9.1k rows, 566.4 KiB processed)", "failures": null, "unique_id": "model.nwr_erd_pipeline.fct_daily_player_kpi", "compiled": true, "compiled_code": "\n\nWITH daily_aggregates AS (\n    SELECT\n        EXTRACT(DATE FROM rating_ts) AS date_day,\n        player_sk,\n        SUM(coin_in) AS daily_coin_in,\n        SUM(theo_amount) AS daily_theo\n    FROM `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\n    WHERE player_sk IS NOT NULL\n    GROUP BY 1, 2\n),\n\nrolling_metrics AS (\n    SELECT\n        date_day,\n        player_sk,\n        daily_coin_in,\n        daily_theo,\n        -- BigQuery optimized rolling 30-day sum using UNIX_DATE\n        SUM(daily_theo) OVER (\n            PARTITION BY player_sk\n            ORDER BY UNIX_DATE(date_day)\n            RANGE BETWEEN 29 PRECEDING AND CURRENT ROW\n        ) AS rolling_30d_theo\n    FROM daily_aggregates\n)\n\nSELECT\n    date_day,\n    player_sk,\n    daily_coin_in,\n    daily_theo,\n    rolling_30d_theo,\n    -- Player is considered \"Active\" if they generated theo in the last 30 days\n    IF(rolling_30d_theo > 0, TRUE, FALSE) AS is_active_flag\nFROM rolling_metrics", "relation_name": "`nwr-data-platform`.`dbt_erd_nwr`.`fct_daily_player_kpi`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-14T15:48:51.421587Z", "completed_at": "2026-10-14T15:48:51.428783Z"}, {"name": "execute", "started_at": "2026-10-14T15:48:51.430337Z", "completed_at": "2026-10-14T15:48:56.306176Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 4.901456356048584, "adapter_response": {"_message": "CREATE TABLE (92.0 rows, 450.9 KiB processed)", "code": "CREATE TABLE", "rows_affected": 92, "bytes_processed": 461754, "bytes_billed": 10485760, "location": "US", "project_id": "nwr-data-platform", "job_id": "30e8323a-9c75-4396-84c6-3ad35a9f9995", "slot_ms": 5612}, "message": "CREATE TABLE (92.0 rows, 450.9 KiB processed)", "failures": null, "unique_id": "model.nwr_erd_pipeline.mart_exec_daily", "compiled": true, "compiled_code": "WITH daily_kpi AS (\n    SELECT * FROM `nwr-data-platform`.`dbt_erd_nwr`.`fct_daily_player_kpi`\n),\n\ndaily_summary AS (\n    SELECT\n        date_day AS run_date,\n        SUM(daily_theo) AS kpi_theo_today,\n        COUNT(DISTINCT IF(is_active_flag, player_sk, NULL)) AS kpi_active_players\n    FROM daily_kpi\n    GROUP BY 1\n)\n\nSELECT\n    run_date,\n    kpi_theo_today,\n    -- Month-to-date calculation using window functions\n    SUM(kpi_theo_today) OVER (\n        PARTITION BY EXTRACT(YEAR FROM run_date), EXTRACT(MONTH FROM run_date)\n        ORDER BY run_date\n    ) AS kpi_theo_mtd,\n    kpi_active_players\nFROM daily_summary", "relation_name": "`nwr-data-platform`.`dbt_erd_nwr`.`mart_exec_daily`", "batch_results": null}], "elapsed_time": 38.18749451637268, "args": {"log_format": "default", "partial_parse_file_diff": true, "export_saved_queries": false, "log_file_max_bytes": 10485760, "log_level_file": "debug", "vars": {}, "require_unique_project_resource_names": false, "require_nested_cumulative_type_params": false, "quiet": false, "partial_parse": true, "invocation_command": "dbt build", "log_path": "D:\\dev\\nwr_erd_analytics\\nwr_erd_pipeline\\logs", "log_level": "info", "macro_debugging": false, "project_dir": "D:\\dev\\nwr_erd_analytics\\nwr_erd_pipeline", "introspect": true, "resource_types": [], "include
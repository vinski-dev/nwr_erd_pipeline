wr-data-platform`.`dbt_erd_nwr`.`fct_ratings`", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-14T15:48:31.228196Z", "completed_at": "2026-10-14T15:48:31.290767Z"}, {"name": "execute", "started_at": "2026-10-14T15:48:31.293286Z", "completed_at": "2026-10-14T15:48:36.894583Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 5.683199882507324, "adapter_response": {"_message": "SELECT (1.0 rows, 0 processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 0, "bytes_billed": 0, "location": "US", "project_id": "nwr-data-platform", "job_id": "9332276b-bc75-4944-85a9-1920381941b1", "slot_ms": 39}, "message": null, "failures": 0, "unique_id": "test.nwr_erd_pipeline.assert_valid_rating_metrics", "compiled": true, "compiled_code": "-- This query replaces Query 3.\n-- If it returns any rows, the dbt test will fail and flag the bad data.\n\nSELECT\n    cms_rating_id,\n    rating_ts,\n    coin_in,\n    house_edge,\n    theo_amount\nFROM `nwr-data-platform`.`dbt_erd_nwr`.`fct_ratings`\nWHERE\n    coin_in < 0\n    OR house_edge < 0\n    OR house_edge > 1\n    OR theo_amount < 0", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-14T15:48:31.240192Z", "completed_at": "2026-10-14T15:48:31.348898Z"}, {"name": "execute", "started_at": "2026-10-14T15:48:31.352893Z", "completed_at": "2026-10-14T15:48:37.000235Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 5.788502931594849, "adapter_response": {"_message": "SELECT (1.0 rows, 0 processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 0, "bytes_billed": 0, "location": "US", "project_id": "nwr-data-platform", "job_id": "bb1764e0-d7a5-4cfe-86a8-87d296163104", "slot_ms": 31}, "message": null, "failures": 0, "unique_id": "test.nwr_erd_pipeline.not_null_fct_ratings_cms_rating_id.157d72ba33", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect cms_rating_id\nfrom `nwr-data-pl
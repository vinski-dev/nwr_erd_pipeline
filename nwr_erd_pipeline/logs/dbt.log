    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings`
      
    
    

    
    OPTIONS()
    as (
      

WITH ratings AS (
    SELECT
        cms_player_id,
        rating_ts,
        game_type,
        coin_in,
        house_edge,
        _loaded_at
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_ratings`
),

identities AS (
    SELECT
        player_sk,
        cms_player_id
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
    WHERE cms_player_id IS NOT NULL
)

        
SELECT
    to_hex(md5(cast(coalesce(cast(r.cms_player_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(r.rating_ts as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_rating_id,
    i.player_sk,
    r.cms_player_id,
    r.game_type,
    r.coin_in,
    r.house_edge,
    r.rating_ts,
    r._loaded_at AS source_loaded_at
FROM ratings r
LEFT JOIN identities i
    ON r.cms_player_id = i.cms_player_id
    );
  
[0m19:10:34.283504 [debug] [Thread-5 (]: On model.nwr_erd_pipeline.fct_campaign_redemption: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "nwr_erd_pipeline", "target_name": "dev", "node_id": "model.nwr_erd_pipeline.fct_campaign_redemption"} */

  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_campaign_redemption`
      
    partition by timestamp_trunc(redemption_date, day)
    cluster by player_sk

    
    OPTIONS()
    as (
      

WITH redemptions AS (
    SELECT
        to_hex(md5(cast(coalesce(cast(campaign_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(member_no as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(redemption_ts as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_redemption_id,
        redemption_ts AS redemption_date,
        redemption_ts,
        offer_amount,
        _loaded_at AS source_loaded_at,
        member_no,
        campaign_id
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_promo_redemptions`

    
),

identities AS (
    SELECT
        player_sk, -- Ensure this matches the primary key column coming from int_player_identity_map
        member_no,
        cms_player_id
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
    WHERE member_no IS NOT NULL
)

SELECT
    r.sk_redemption_id,
    i.player_sk,
    i.cms_player_id,
    r.campaign_id,
    to_hex(md5(cast(coalesce(cast(r.campaign_id as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_campaign_id,
    r.redemption_date,
    r.offer_amount,
    r.source_loaded_at
FROM redemptions r
JOIN identities i
    ON r.member_no = i.member_no
    );
  

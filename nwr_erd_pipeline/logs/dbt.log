        -- generated script to merge partitions into `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings`
      declare dbt_partitions_for_replacement array<timestamp>;

      
      
       -- 1. create a temp table with model data
        
  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp213909672974`
      
    partition by timestamp_trunc(rating_ts, day)
    cluster by player_master_sk

    
    OPTIONS(
      expiration_timestamp=TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 12 hour)
    )
    as (
      

WITH ratings AS (
    SELECT *
    FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_ratings` where false limit 0)

    
        WHERE rating_ts >= (
            SELECT COALESCE(MAX(rating_ts), CAST('1900-01-01' AS TIMESTAMP))
            FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings`
        )
    
),

player_dim AS (
    SELECT
        player_version_sk,
        player_master_sk,
        cms_player_id,
        valid_from_ts,
        valid_to_ts
    FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`dim_players` where false limit 0)
    WHERE cms_player_id IS NOT NULL
)

SELECT
    r.sk_rating_id,
    r.rating_ts,
    r.game_type,
    r.coin_in,
    r.house_edge,

    -- Business Logic: Calculating Theo Win for BI
    (r.coin_in * r.house_edge) AS theoretical_win,
    r.source_loaded_at,

    -- Dimensional Mapping
    COALESCE(d.player_version_sk, 'UNKNOWN_PLAYER') AS player_version_sk,
    COALESCE(d.player_master_sk, 'UNKNOWN_PLAYER') AS player_master_sk

FROM ratings r
-- Point-in-Time Join using your exact CMS identifier
LEFT JOIN player_dim d
    ON
        r.cms_player_id = d.cms_player_id
        AND r.rating_ts >= d.valid_from_ts
        AND r.rating_ts < d.valid_to_ts
    );
  
      -- 2. define partitions to update
      set (dbt_partitions_for_replacement) = (
          select as struct
              -- IGNORE NULLS: this needs to be aligned to _dbt_max_partition, which ignores null
              array_agg(distinct timestamp_trunc(rating_ts, day) IGNORE NULLS)
          from `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp213909672974`
      );

      -- 3. run the merge statement
      

    merge into `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings` as DBT_INTERNAL_DEST
        using (
        select
        * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp213909672974`
      ) as DBT_INTERNAL_SOURCE
        on FALSE

    when not matched by source
         and timestamp_trunc(DBT_INTERNAL_DEST.rating_ts, day) in unnest(dbt_partitions_for_replacement) 
        then delete

    when not matched then insert
        (`sk_rating_id`, `sk_player_id`, `rating_ts`, `game_type`, `coin_in`, `house_edge`, `theo_amount`)
    values
        (`sk_rating_id`, `sk_player_id`, `rating_ts`, `game_type`, `coin_in`, `house_edge`, `theo_amount`)

;

      -- 4. clean up the temp table
      drop table if exists `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp213909672974`

  


    


    

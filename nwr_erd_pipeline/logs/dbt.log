    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_campaign_redemption`
      
    
    

    
    OPTIONS()
    as (
      WITH redemptions AS (
    SELECT * FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_promo_redemptions`
),
identities AS (

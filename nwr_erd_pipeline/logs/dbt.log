),  __dbt__cte__fct_campaign_redemption as (

-- Fixture for fct_campaign_redemption
select safe_cast(null as STRING) as `sk_redemption_id`, safe_cast(null as STRING) as `cms_player_id`, safe_cast('''camp_1''' as STRING) as `sk_campaign_id`, safe_cast(null as STRING) as `player_master_sk`, safe_cast('''2026-10-01 10:00:00''' as TIMESTAMP) as `redemption_date`, safe_cast(100.0 as FLOAT64) as `offer_amount`, safe_cast(null as TIMESTAMP) as `source_loaded_at`
),  __dbt__cte__mart_player_daily_summary as (

-- Fixture for mart_player_daily_summary
select safe_cast('''p_1''' as STRING) as `player_master_sk`, safe_cast('''2026-10-01''' as DATE) as `play_date`, safe_cast(null as STRING) as `first_name`, safe_cast(null as STRING) as `last_name`, safe_cast(null as STRING) as `tier`, safe_cast(null as FLOAT64) as `total_coin_in`, safe_cast(null as FLOAT64) as `total_theoretical_win`
), player_dim AS (
    -- Safely mapping the business key to your new master surrogate key
    SELECT DISTINCT

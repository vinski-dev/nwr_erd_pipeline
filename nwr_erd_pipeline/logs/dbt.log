[0m00:26:24.058639 [debug] [Thread-7 (]: Writing runtime sql for node "model.nwr_erd_pipeline.fct_daily_player_kpi"
[0m00:26:24.058639 [debug] [Thread-7 (]: On model.nwr_erd_pipeline.fct_daily_player_kpi: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "nwr_erd_pipeline", "target_name": "dev", "node_id": "model.nwr_erd_pipeline.fct_daily_player_kpi"} */


  create or replace view `nwr-data-platform`.`dbt_erd_nwr`.`fct_daily_player_kpi`
  OPTIONS()
  as 

WITH daily_aggregates AS (
    SELECT
        EXTRACT(DATE FROM rating_ts) AS date_day,
        player_sk,
        SUM(coin_in) AS daily_coin_in,
        SUM(theo_amount) AS daily_theo
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings`
    WHERE player_sk IS NOT NULL
    GROUP BY 1, 2
),

rolling_metrics AS (
    SELECT
        date_day,
        player_sk,
        daily_coin_in,
        daily_theo,
        -- BigQuery optimized rolling 30-day sum using UNIX_DATE
        SUM(daily_theo) OVER (
            PARTITION BY player_sk
            ORDER BY UNIX_DATE(date_day)
            RANGE BETWEEN 29 PRECEDING AND CURRENT ROW
        ) AS rolling_30d_theo
    FROM daily_aggregates
)

SELECT
    date_day,
    player_sk,
    daily_coin_in,
    daily_theo,
    rolling_30d_theo,
    -- Player is considered "Active" if they generated theo in the last 30 days
    IF(rolling_30d_theo > 0, TRUE, FALSE) AS is_active_flag
FROM rolling_metrics;


[0m00:26:24.212104 [debug] [Thread-5 (]: Writing runtime sql for node "model.nwr_erd_pipeline.mart_campaign_performance"
[0m00:26:24.214120 [debug] [Thread-5 (]: On model.nwr_erd_pipeline.mart_campaign_performance: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "nwr_erd_pipeline", "target_name": "dev", "node_id": "model.nwr_erd_pipeline.mart_campaign_performance"} */

  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr`.`mart_campaign_performance`
      
    
    

    
    OPTIONS()
    as (
      

WITH redemptions AS (
    SELECT
        sk_campaign_id,
        sk_player_id,
        MIN(redemption_ts) AS first_redemption_ts,
        SUM(offer_amount) AS total_offer_amount
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_campaign_redemption`
    GROUP BY 1, 2
),

player_play AS (
    SELECT
        sk_player_id,
        rating_ts,
        theo_amount
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings`
),

performance_calc AS (
    SELECT
        r.sk_campaign_id,
        r.sk_player_id,
        TRUE AS is_redeemed,
        r.total_offer_amount,
        -- Post-campaign play: Theo generated within 3 days AFTER redemption
        SUM(CASE
            WHEN
                p.rating_ts BETWEEN r.first_redemption_ts
                AND TIMESTAMP_ADD(r.first_redemption_ts, INTERVAL 3 DAY)
                THEN p.theo_amount
            ELSE 0
        END) AS post_campaign_theo,

        -- Baseline play: Theo generated in the 3 days PRIOR to redemption
        SUM(CASE
            WHEN
                p.rating_ts BETWEEN TIMESTAMP_SUB(
                    r.first_redemption_ts, INTERVAL 3 DAY
                )
                AND r.first_redemption_ts
                THEN p.theo_amount
            ELSE 0
        END) AS baseline_theo
    FROM redemptions r
    LEFT JOIN player_play p ON r.sk_player_id = p.sk_player_id
    GROUP BY 1, 2, 3, 4
)

SELECT
    sk_campaign_id,
    sk_player_id,
    is_redeemed,
    total_offer_amount,
    post_campaign_theo,
    baseline_theo,
    -- Core Business Metrics defined in one place
    (post_campaign_theo - baseline_theo) AS incremental_theo,
    SAFE_DIVIDE(total_offer_amount, post_campaign_theo) AS reinvestment_rate
FROM performance_calc
    );
  

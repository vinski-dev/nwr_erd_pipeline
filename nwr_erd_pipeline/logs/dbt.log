  create or replace view `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
  OPTIONS()
  as 

with cms_players as (
    select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_players`
),

loyalty_members as (
    select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_loyalty_members`
)

select
    -- Stable natural key resolved across systems
    coalesce(c.cms_player_id, l.member_no) as player_natural_key,
    c.cms_player_id,
    l.member_no,

    -- Conformed attributes (resolving overlaps via email PII)
    coalesce(c.email, l.email) as email,
    coalesce(c.first_name, l.first_name) as first_name,
    coalesce(c.last_name, l.last_name) as last_name,
    coalesce(c.dob, l.dob) as dob,

    -- Loyalty attributes
    l.tier as loyalty_tier,
    l.enroll_date,

    -- Source coverage tracking flags
    case when c.cms_player_id is not null then true else false end as has_casino_profile,
    case when l.member_no is not null then true else false end as has_loyalty_profile

from cms_players c
full outer join loyalty_members l
    on c.email = l.email;



    COALESCE(pd.total_theoretical_win, 0) AS trip_theoretical_win,

    -- ROI Calculation
    (COALESCE(pd.total_theoretical_win, 0) - c.offer_amount)
        AS campaign_net_margin

FROM campaign_redemptions c
LEFT JOIN player_dim p
    ON c.cms_player_id = p.cms_player_id
-- Joining to the daily summary we just built to get performance metrics
LEFT JOIN player_daily pd
    ON
        p.player_master_sk = pd.player_master_sk
        AND CAST(c.redemption_date AS DATE) = pd.play_date
  ) _dbt_internal_unit_test_actual
),
-- Build expected result
dbt_internal_unit_test_expected as (
  select
    `campaign_id`, `offer_amount`, '''expected''' as `actual_or_expected`
  from (
    select safe_cast('''camp_1''' as STRING) as `campaign_id`, safe_cast(100.0 as FLOAT64) as `offer_amount`
  ) _dbt_internal_unit_test_expected
)
-- Union actual and expected results
select * from dbt_internal_unit_test_actual
union all
select * from dbt_internal_unit_test_expected

[0m19:16:19.262441 [debug] [Thread-3 (]: On model.nwr_erd_pipeline.mart_exec_daily: /* {"app": "dbt", "dbt_version": "1.11.12", "profile_name": "casino_platform", "target_name": "dev", "node_id": "model.nwr_erd_pipeline.mart_exec_daily"} */

  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr`.`mart_exec_daily`
      
    
    

    
    OPTIONS()
    as (
      WITH daily_kpi AS (
    SELECT * FROM `nwr-data-platform`.`dbt_erd_nwr`.`fct_daily_player_kpi`
),

daily_summary AS (
    SELECT
        date_day AS run_date,
        SUM(daily_theo) AS kpi_theo_today,
        COUNT(DISTINCT IF(is_active_flag, player_sk, NULL)) AS kpi_active_players
    FROM daily_kpi
    GROUP BY 1
)

SELECT
    run_date,
    kpi_theo_today,
    -- Month-to-date calculation using window functions
    SUM(kpi_theo_today) OVER (
        PARTITION BY EXTRACT(YEAR FROM run_date), EXTRACT(MONTH FROM run_date)
        ORDER BY run_date
    ) AS kpi_theo_mtd,
    kpi_active_players
FROM daily_summary
    );
  

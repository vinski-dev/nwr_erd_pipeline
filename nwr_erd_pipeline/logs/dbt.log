  create or replace view `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_players`
  OPTIONS()
  as WITH source AS (
    SELECT * FROM (select * from `nwr-data-platform`.`bronze`.`cms_players` where false limit 0)
)

SELECT
    CAST(cms_player_id AS STRING) AS cms_player_id,
    TRIM(first_name) AS first_name,
    TRIM(last_name) AS last_name,
    CAST(dob AS DATE) AS dob,
    -- Normalizes case and removes spaces before checking against a list of bad values
    CASE
        WHEN
            LOWER(TRIM(email)) IN ('', 'n/a', 'na', 'none', 'null', 'undefined')
            THEN NULL
        ELSE TRIM(email)
    END AS email,
    CAST(_loaded_at AS TIMESTAMP) AS source_loaded_at
FROM source;



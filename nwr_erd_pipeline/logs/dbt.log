    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp213019951419`
      
    partition by timestamp_trunc(rating_ts, day)
    cluster by player_master_sk

    
    OPTIONS(
      expiration_timestamp=TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 12 hour)
    )
    as (
      

WITH ratings AS (
    SELECT *
    FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_ratings` where false limit 0)

    
    WHERE rating_ts >= (
        SELECT COALESCE(MAX(rating_ts), '1900-01-01')
        FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings`
    )
    
),

player_dim AS (
    SELECT
        player_version_sk,
        player_master_sk,
        cms_player_id,
        valid_from_ts,
        valid_to_ts
    FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`dim_players` where false limit 0)
    WHERE cms_player_id IS NOT NULL
)

SELECT
    r.sk_rating_id,
    r.rating_ts,
    r.game_type,
    r.coin_in,
    r.house_edge,

    -- Business Logic: Calculating Theo Win for BI
    (r.coin_in * r.house_edge) AS theoretical_win,
    r.source_loaded_at,

    -- Dimensional Mapping
    COALESCE(d.player_version_sk, 'UNKNOWN_PLAYER') AS player_version_sk,
    d.player_master_sk

FROM ratings r
-- Point-in-Time Join using your exact CMS identifier
LEFT JOIN player_dim d
    ON r.cms_player_id = d.cms_player_id
    AND r.rating_ts >= d.valid_from_ts
    AND r.rating_ts < d.valid_to_ts
    );
  

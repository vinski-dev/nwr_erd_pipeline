    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`dim_players`
      
    
    cluster by player_master_sk

    
    OPTIONS()
    as (
      

WITH identity AS (
    SELECT *
    FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map` where false limit 0)
),

player_history AS (
    SELECT *
    FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_players` where false limit 0)
)

SELECT
    -- 1. The Versioned Surrogate Key
    to_hex(md5(cast(coalesce(cast(i.sk_player_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(COALESCE(CAST(h.dbt_valid_from AS STRING), '1900-01-01') as string), '_dbt_utils_surrogate_key_null_') as string))) AS player_version_sk,

    -- 2. Master Key
    i.sk_player_id AS player_master_sk,

    -- The CMS Player ID (previously casino_account_id)
    i.cms_player_id,

    -- 3. Explicit Defaulting
    COALESCE(h.first_name, 'Anonymous') AS first_name,
    COALESCE(h.last_name, 'Player') AS last_name,
    h.email,
    COALESCE(h.tier, 'Uncarded') AS loyalty_tier,

    COALESCE(h.dbt_valid_from, CAST('1900-01-01' AS TIMESTAMP))
        AS valid_from_ts
    COALESCE(h.dbt_valid_from, CAST('1900-01-01' AS TIMESTAMP)) AS valid_from_ts,
    COALESCE(h.dbt_valid_to, CAST('9999-12-31' AS TIMESTAMP)) AS valid_to_ts,

    CASE
        -- Walk-ups are always 'current'
        WHEN h.casino_account_id IS NULL THEN TRUE
        WHEN h.dbt_valid_to IS NULL THEN TRUE      -- Active record
        ELSE FALSE                                 -- Historical record
    END AS is_current_record
    END AS is_current_record

FROM identity i
LEFT JOIN player_history h

    -- The exact join condition causing the line 54 error
    ON i.cms_player_id = h.cms_player_id
    );
  

[0m21:36:34.226375 [debug] [Thread-5 (]: On model.nwr_erd_pipeline.fct_campaign_redemption: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "nwr_erd_pipeline", "target_name": "dev", "node_id": "model.nwr_erd_pipeline.fct_campaign_redemption"} */

  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_campaign_redemption`
      
    partition by timestamp_trunc(redemption_date, day)
    cluster by player_sk

    
    OPTIONS()
    as (
      

WITH redemptions AS (
    SELECT
        campaign_id,
        member_no,
        redemption_ts,
        redemption_ts AS redemption_date,
        offer_amount,
        _loaded_at AS source_loaded_at
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_promo_redemptions`

    

    -- Automatically drops exact physical duplicate rows from the source batch
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY
            campaign_id, member_no, redemption_ts, offer_amount, _loaded_at
        ORDER BY campaign_id
    ) = 1
),

identities AS (
    SELECT
        player_sk,

        member_no,
        cms_player_id
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
    WHERE member_no IS NOT NULL
)

SELECT
        -- Hashing the natural key + _loaded_at guarantees 100% incremental-safe uniqueness
    to_hex(md5(cast(coalesce(cast(r.campaign_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(r.member_no as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(r.redemption_ts as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(r.offer_amount as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(r.source_loaded_at as string), '_dbt_utils_surrogate_key_null_') as string)))
        AS sk_redemption_id,
    COALESCE(i.player_sk, 'UNKNOWN_PLAYER') AS player_sk,
    i.cms_player_id,
    r.campaign_id,
    to_hex(md5(cast(coalesce(cast(r.campaign_id as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_campaign_id,
    r.redemption_date,
    r.offer_amount,
    r.source_loaded_at
FROM redemptions r
LEFT JOIN identities i
    ON r.member_no = i.member_no
    );
  

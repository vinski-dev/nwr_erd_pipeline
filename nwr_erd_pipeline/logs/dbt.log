WITH ratings AS (
    SELECT
        cms_player_id,
        rating_ts,
        game_type,
        coin_in,
        house_edge,
        _loaded_at
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_ratings`

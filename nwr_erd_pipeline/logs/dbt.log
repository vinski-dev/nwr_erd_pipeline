[0m00:33:06.466045 [debug] [Thread-8 (]: On model.nwr_erd_pipeline.fct_ratings: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "nwr_erd_pipeline", "target_name": "dev", "node_id": "model.nwr_erd_pipeline.fct_ratings"} */

  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings`
      
    partition by timestamp_trunc(rating_ts, day)
    cluster by player_master_sk

    
    OPTIONS()
    as (
      

WITH ratings AS (
    SELECT *
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_ratings`

    
),

player_dim AS (
    SELECT
        player_version_sk,
        player_master_sk,
        cms_player_id,
        valid_from_ts,
        valid_to_ts
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`dim_players`
    WHERE cms_player_id IS NOT NULL
)

SELECT
    r.sk_rating_id,
    r.rating_ts,
    r.game_type,
    r.coin_in,
    r.house_edge,

    -- Business Logic: Calculating Theo Win for BI
    (r.coin_in * r.house_edge) AS theoretical_win,
    r.source_loaded_at,

    -- Dimensional Mapping
    COALESCE(d.player_version_sk, 'UNKNOWN_PLAYER') AS player_version_sk,
    COALESCE(d.player_master_sk, 'UNKNOWN_PLAYER') AS player_master_sk

FROM ratings r
-- Point-in-Time Join using your exact CMS identifier
LEFT JOIN player_dim d
    ON
        r.cms_player_id = d.cms_player_id
        AND r.rating_ts >= d.valid_from_ts
        AND r.rating_ts < d.valid_to_ts
    );
  

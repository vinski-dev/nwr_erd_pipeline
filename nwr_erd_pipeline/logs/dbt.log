    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
      
    
    

    
    OPTIONS()
    as (
      -- Inside int_player_identity_map.sql
WITH cms AS (
    SELECT cms_player_id, first_name, last_name, dob FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_players` where false limit 0)
),
loyalty AS (
    SELECT member_no, first_name, last_name, dob, tier FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_loyalty_members` where false limit 0)
),
matched AS (
    SELECT
        c.cms_player_id,
        l.member_no,
        COALESCE(c.first_name, l.first_name) AS first_name,
        COALESCE(c.last_name, l.last_name) AS last_name,
        COALESCE(c.dob, l.dob) AS dob,
        l.tier  -- Make sure this is here!
    FROM cms c
    FULL OUTER JOIN loyalty l
        ON c.first_name = l.first_name
        AND c.last_name = l.last_name
        AND c.dob = l.dob
)
SELECT
    to_hex(md5(cast(coalesce(cast(first_name as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(last_name as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(dob as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_player_id,
    cms_player_id,
    member_no,
    first_name,
    last_name,
    dob,
    tier -- And make sure it is output here!
FROM matched
    );
  

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
      
    
    

    
    OPTIONS()
    as (
      WITH cms AS (
    -- Ensure email is selected from staging
    SELECT cms_player_id, first_name, last_name, dob, email
    FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_players` where false limit 0)
),
loyalty AS (
    -- Assuming loyalty also captures email
    SELECT member_no, first_name, last_name, dob, tier, email
    FROM (select * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_loyalty_members` where false limit 0)
),
matched AS (
    SELECT
        c.cms_player_id,
        l.member_no,
        COALESCE(c.first_name, l.first_name) AS first_name,
        COALESCE(c.last_name, l.last_name) AS last_name,
        COALESCE(c.dob, l.dob) AS dob,
        -- Resolve the email
        COALESCE(l.email, c.email) AS email,
        l.tier
    FROM cms c
    FULL OUTER JOIN loyalty l
        ON c.first_name = l.first_name
        AND c.last_name = l.last_name
        AND c.dob = l.dob
)
SELECT
    to_hex(md5(cast(coalesce(cast(first_name as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(last_name as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(dob as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_player_id,
    cms_player_id,
    member_no,
    first_name,
    last_name,
    dob,
    email, -- Explicitly output it
    tier
FROM matched
    );
  

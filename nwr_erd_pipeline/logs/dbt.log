[0m19:57:37.419560 [debug] [Thread-5 (]: On model.nwr_erd_pipeline.dim_players: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "nwr_erd_pipeline", "target_name": "dev", "node_id": "model.nwr_erd_pipeline.dim_players"} */

  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`dim_players`
      
    
    cluster by player_master_sk

    
    OPTIONS()
    as (
      

WITH identity AS (
    SELECT *
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
),

player_history AS (
    -- Assuming stg_cms_players holds the historical SCD Type 2 records
    SELECT *
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_players`
)

SELECT
    -- 1. The Versioned Surrogate Key: Prevents fan-out bugs in downstream fact tables
    to_hex(md5(cast(coalesce(cast(i.sk_player_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(COALESCE(CAST(h.dbt_valid_from AS STRING), '1900-01-01') as string), '_dbt_utils_surrogate_key_null_') as string))) AS player_version_sk,

    -- 2. Master Key for lifetime value aggregation across tier changes
    i.sk_player_id AS player_master_sk,
    i.casino_account_id,

    -- 3. Explicit Defaulting for walk-ups
    COALESCE(h.first_name, 'Anonymous') AS first_name,
    COALESCE(h.last_name, 'Player') AS last_name,
    h.email,
    COALESCE(h.tier, 'Uncarded') AS loyalty_tier,

    -- 4. SCD Type 2 Timestamps
    COALESCE(h.dbt_valid_from, CAST('1900-01-01' AS TIMESTAMP)) AS valid_from_ts,
    COALESCE(h.dbt_valid_to, CAST('9999-12-31' AS TIMESTAMP)) AS valid_to_ts,

    -- 5. The BI Current Record Flag
    CASE
        WHEN h.casino_account_id IS NULL THEN TRUE -- Walk-ups are always 'current'
        WHEN h.dbt_valid_to IS NULL THEN TRUE      -- Active record
        ELSE FALSE                                 -- Historical record
    END AS is_current_record

FROM identity i
LEFT JOIN player_history h
    ON i.casino_account_id = h.casino_account_id
    );
  

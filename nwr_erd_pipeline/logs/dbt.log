  create or replace view `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_ratings`
  OPTIONS()
  as WITH source AS (
    SELECT * FROM `nwr-data-platform`.`bronze`.`cms_ratings`
)
SELECT
    to_hex(md5(cast(coalesce(cast(cms_player_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(rating_ts as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(game_type as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_rating_id,
    CAST(cms_player_id AS STRING) AS cms_player_id,
    CAST(rating_ts AS TIMESTAMP) AS rating_ts,
    CAST(game_type AS STRING) AS game_type,
    CAST(coin_in AS FLOAT64) AS coin_in,
    CAST(house_edge AS FLOAT64) AS house_edge,
    CAST(_loaded_at AS TIMESTAMP) AS source_loaded_at

    SELECT * FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_promo_redemptions`
),
identities AS (
    SELECT sk_player_id, member_no FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
    WHERE member_no IS NOT NULL
)
SELECT
    r.sk_redemption_id,
    -- Use the conformed sk_campaign_id to link to your dim_campaign model
    to_hex(md5(cast(coalesce(cast(r.campaign_id as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_campaign_id,
    i.sk_player_id,
    r.redemption_ts,
    r.offer_amount
FROM redemptions r
JOIN identities i ON r.member_no = i.member_no
    );
  

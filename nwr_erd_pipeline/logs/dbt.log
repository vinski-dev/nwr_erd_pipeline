    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_campaign_redemption`
      
    partition by timestamp_trunc(redemption_ts, day)
    cluster by player_master_sk

    
    OPTIONS()
    as (
      

WITH redemptions AS (
    SELECT
        sk_redemption_id,
        redemption_ts,
        offer_amount,
        source_loaded_at,
        member_no,
        campaign_id -- Added back here so r.campaign_id exists
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_promo_redemptions`

    
),

identities AS (
    SELECT
        player_master_sk,
        member_no,
        cms_player_id
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
    WHERE member_no IS NOT NULL
)

SELECT
    r.sk_redemption_id,
    i.cms_player_id,
    -- Links to your future dim_campaign model
    to_hex(md5(cast(coalesce(cast(r.campaign_id as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_campaign_id,
    i.player_master_sk,
    r.redemption_ts AS redemption_date,
    r.offer_amount,
    r.source_loaded_at
FROM redemptions r
JOIN identities i
    ON r.member_no = i.member_no
    );
  

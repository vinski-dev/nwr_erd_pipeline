[0m01:59:02.098704 [debug] [Thread-8 (]: On model.nwr_erd_pipeline.mart_campaign_performance: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "nwr_erd_pipeline", "target_name": "dev", "node_id": "model.nwr_erd_pipeline.mart_campaign_performance"} */

  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_gold`.`mart_campaign_performance`
      
    
    cluster by campaign_id

    
    OPTIONS()
    as (
      

WITH player_dim AS (
    -- Safely mapping the business key to your new master surrogate key
    SELECT DISTINCT
        player_master_sk,
        cms_player_id
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`dim_players`
),

campaign_redemptions AS (
    SELECT *
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_campaign_redemption`
),

player_daily AS (
    SELECT *
    FROM `nwr-data-platform`.`dbt_erd_nwr_gold`.`mart_player_daily_summary`
)

SELECT
    c.sk_campaign_id AS campaign_id,
    c.redemption_date,
    p.player_master_sk,
    c.offer_amount,

    -- Evaluating if the player generated theo on the exact day they redeemed the offer
    COALESCE(pd.total_coin_in, 0) AS trip_coin_in,
    COALESCE(pd.total_theoretical_win, 0) AS trip_theoretical_win,

    -- ROI Calculation
    (COALESCE(pd.total_theoretical_win, 0) - c.offer_amount)
        AS campaign_net_margin

FROM campaign_redemptions c
LEFT JOIN player_dim p
    ON c.cms_player_id = p.cms_player_id
-- Joining to the daily summary we just built to get performance metrics
LEFT JOIN player_daily pd
    ON
        p.player_master_sk = pd.player_master_sk
        AND CAST(c.redemption_date AS DATE) = pd.play_date
    );
  

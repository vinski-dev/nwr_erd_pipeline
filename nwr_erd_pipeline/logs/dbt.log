WITH  __dbt__cte__dim_players as (

-- Fixture for dim_players
select safe_cast(null as STRING) as `player_version_sk`, safe_cast('''p_1''' as STRING) as `player_master_sk`, safe_cast(null as STRING) as `cms_player_id`, safe_cast(null as STRING) as `member_no`, safe_cast(null as STRING) as `first_name`, safe_cast(null as STRING) as `last_name`, safe_cast(null as DATE) as `dob`, safe_cast(null as STRING) as `email`, safe_cast(null as STRING) as `tier`, safe_cast(null as TIMESTAMP) as `valid_from_ts`, safe_cast(null as TIMESTAMP) as `valid_to_ts`, safe_cast(null as BOOLEAN) as `is_current_record`
),  __dbt__cte__fct_campaign_redemption as (

-- Fixture for fct_campaign_redemption
select safe_cast(null as STRING) as `sk_redemption_id`, safe_cast(null as STRING) as `cms_player_id`, safe_cast('''camp_1''' as STRING) as `sk_campaign_id`, safe_cast(null as STRING) as `player_master_sk`, safe_cast('''2026-10-01 10:00:00''' as TIMESTAMP) as `redemption_date`, safe_cast(100.0 as FLOAT64) as `offer_amount`, safe_cast(null as TIMESTAMP) as `source_loaded_at`
),  __dbt__cte__mart_player_daily_summary as (

-- Fixture for mart_player_daily_summary
select safe_cast('''p_1''' as STRING) as `player_master_sk`, safe_cast('''2026-10-01''' as DATE) as `play_date`, safe_cast(null as STRING) as `first_name`, safe_cast(null as STRING) as `last_name`, safe_cast(null as STRING) as `tier`, safe_cast(null as FLOAT64) as `total_coin_in`, safe_cast(null as FLOAT64) as `total_theoretical_win`
), player_dim AS (
    -- Safely mapping the business key to your new master surrogate key
    SELECT DISTINCT
        player_master_sk,
        cms_player_id
    FROM __dbt__cte__dim_players
),

campaign_redemptions AS (
    SELECT *
    FROM __dbt__cte__fct_campaign_redemption
),

player_daily AS (
    SELECT *
    FROM __dbt__cte__mart_player_daily_summary
)

SELECT
    c.sk_campaign_id AS campaign_id,
    c.redemption_date,
    p.player_master_sk,
    c.offer_amount,

    -- Evaluating if the player generated theo on the exact day they redeemed the offer
    COALESCE(pd.total_coin_in, 0) AS trip_coin_in,
    COALESCE(pd.total_theoretical_win, 0) AS trip_theoretical_win,

    -- ROI Calculation
    (COALESCE(pd.total_theoretical_win, 0) - c.offer_amount)
        AS campaign_net_margin

FROM campaign_redemptions c
LEFT JOIN player_dim p
    ON c.cms_player_id = p.cms_player_id
-- Joining to the daily summary we just built to get performance metrics
LEFT JOIN player_daily pd
    ON
        p.player_master_sk = pd.player_master_sk
        AND CAST(c.redemption_date AS DATE) = pd.play_date
    ) as __dbt_sbq
    where false and current_timestamp() = current_timestamp()
    limit 0

    );
  
  

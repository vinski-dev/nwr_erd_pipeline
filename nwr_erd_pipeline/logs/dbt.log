    partition by timestamp_trunc(redemption_date, day)
    cluster by player_sk

    
    OPTIONS(
      expiration_timestamp=TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 12 hour)
    )
    as (
      

WITH redemptions_raw AS (
    SELECT
        campaign_id,
        member_no,
        redemption_ts,
        offer_amount,
        _loaded_at
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_promo_redemptions`

    
        WHERE redemption_ts >= (
            SELECT COALESCE(MAX(redemption_ts), '1900-01-01')
            FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_campaign_redemption`
        )
    
),

redemptions AS (
    SELECT
        -- Assign a unique row sequence per natural key combination to prevent duplicate surrogate keys
        ROW_NUMBER() OVER (
            PARTITION BY campaign_id, member_no, redemption_ts

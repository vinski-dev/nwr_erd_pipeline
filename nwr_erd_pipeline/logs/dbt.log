    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_campaign_redemption`
      
    partition by timestamp_trunc(redemption_date, day)
    cluster by player_sk

    
    OPTIONS()
    as (
      

WITH redemptions AS (
    SELECT
        to_hex(md5(cast(coalesce(cast(campaign_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(member_no as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(redemption_ts as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_redemption_id,
        redemption_ts AS redemption_date,
        redemption_ts,
        offer_amount,
        _loaded_at AS source_loaded_at,
        member_no,
        campaign_id
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_promo_redemptions`

    
),

identities AS (
    SELECT
        player_sk,
        member_no,
        cms_player_id
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
    WHERE member_no IS NOT NULL
)

SELECT
    r.sk_redemption_id,
    i.cms_player_id,
    r.campaign_id,                                              -- Natural key for easy reference
    to_hex(md5(cast(coalesce(cast(r.campaign_id as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_campaign_id, -- Surrogate key for dim_campaign
    i.player_sk,
    r.redemption_date,
    r.offer_amount,
    r.source_loaded_at
FROM redemptions r
JOIN identities i
    ON r.member_no = i.member_no
    );
  

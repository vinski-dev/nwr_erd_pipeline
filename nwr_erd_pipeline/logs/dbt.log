          from `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp193712168630`
      );

      -- 3. run the merge statement
      

    merge into `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings` as DBT_INTERNAL_DEST
        using (
        select
        * from `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp193712168630`
      ) as DBT_INTERNAL_SOURCE
        on FALSE

    when not matched by source
         and timestamp_trunc(DBT_INTERNAL_DEST.redemption_ts, day) in unnest(dbt_partitions_for_replacement) 
        then delete

    when not matched then insert
        (`sk_rating_id`, `sk_player_id`, `rating_ts`, `game_type`, `coin_in`, `house_edge`, `theo_amount`)
    values
        (`sk_rating_id`, `sk_player_id`, `rating_ts`, `game_type`, `coin_in`, `house_edge`, `theo_amount`)

;

      -- 4. clean up the temp table
      drop table if exists `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp193712168630`

  


    


    

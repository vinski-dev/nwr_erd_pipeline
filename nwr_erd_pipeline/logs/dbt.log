      declare dbt_partitions_for_replacement array<timestamp>;

      
      
       -- 1. create a temp table with model data
        
  
    

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings__dbt_tmp193712168630`
      
    partition by timestamp_trunc(redemption_ts, day)
    cluster by player_master_sk

    
    OPTIONS(
      expiration_timestamp=TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 12 hour)
    )
    as (
      

WITH redemptions AS (
    SELECT *
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_promo_redemptions`

    
    WHERE redemption_ts >= (
        SELECT COALESCE(MAX(redemption_ts), '1900-01-01')
        FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`fct_ratings`
    )
    
),

player_dim AS (
    SELECT
        player_version_sk,
        player_master_sk,
        legacy_hotel_id,
        casino_account_id,
        valid_from_ts,
        valid_to_ts
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`dim_players`
)

SELECT
    r.redemption_id,
    r.campaign_id,
    r.redemption_ts,
    r.promo_code,
    r.discount_amount,

    -- Consistent key mapping across all fact tables
    COALESCE(d.player_version_sk, 'UNKNOWN_PLAYER') AS player_version_sk,
    d.player_master_sk

FROM redemptions r
-- Point-in-Time Join: Captures the player's exact profile state when they redeemed the promo
LEFT JOIN player_dim d
    ON (r.account_id = d.casino_account_id OR r.account_id = d.legacy_hotel_id)
    AND r.redemption_ts >= d.valid_from_ts
    AND r.redemption_ts < d.valid_to_ts
    );
  

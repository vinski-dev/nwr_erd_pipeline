    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
      
    
    

    
    OPTIONS()
    as (
      WITH cms_players AS (
    SELECT
        cms_player_id,
        first_name,
        last_name,
        dob
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_cms_players`
),

loyalty_members AS (
    SELECT
        member_no,
        first_name,
        last_name,
        dob
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`stg_loyalty_members`
),

matched_identities AS (
    -- Resolve identities by joining on deterministic PII
    SELECT
        c.cms_player_id,
        l.member_no,
        COALESCE(c.first_name, l.first_name) AS first_name,
        COALESCE(c.last_name, l.last_name) AS last_name,
        COALESCE(c.dob, l.dob) AS dob
    FROM cms_players c
    FULL OUTER JOIN loyalty_members l
        ON c.first_name = l.first_name
        AND c.last_name = l.last_name
        AND c.dob = l.dob
)

SELECT
    -- Generate the conformed enterprise surrogate key
    to_hex(md5(cast(coalesce(cast(cms_player_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(member_no as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_player_id,
    cms_player_id,
    member_no,
    first_name,
    last_name,
    dob
FROM matched_identities
    );
  

    create or replace table `nwr-data-platform`.`dbt_erd_nwr_silver`.`dim_players`
      
    
    cluster by player_master_sk

    
    OPTIONS()
    as (
      

WITH identity AS (
    SELECT *
    FROM `nwr-data-platform`.`dbt_erd_nwr_silver`.`int_player_identity_map`
),

player_history AS (
    SELECT *
    FROM `nwr-data-platform`.`silver`.`dim_players_snapshot`
)

SELECT
    to_hex(md5(cast(coalesce(cast(i.player_master_sk as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(h.dbt_valid_from as string), '_dbt_utils_surrogate_key_null_') as string)))
        AS player_version_sk,
    i.player_master_sk AS player_master_sk,
    i.cms_player_id,
    i.member_no,

    COALESCE(h.first_name, 'Anonymous') AS first_name,
    COALESCE(h.last_name, 'Player') AS last_name,
    h.dob,
    h.email,
    COALESCE(h.tier, 'Uncarded') AS tier,

    COALESCE(h.dbt_valid_from, CAST('1900-01-01' AS TIMESTAMP))
        AS valid_from_ts,
    COALESCE(h.dbt_valid_to, CAST('9999-12-31' AS TIMESTAMP)) AS valid_to_ts,

    CASE
        WHEN h.cms_player_id IS NULL THEN TRUE
        WHEN h.dbt_valid_to IS NULL THEN TRUE
        ELSE FALSE
    END AS is_current_record

FROM identity i
LEFT JOIN player_history h
    ON i.cms_player_id = h.cms_player_id

UNION ALL

-- Explicit fallback record for uncarded/unknown play to satisfy referential integrity
SELECT
    'UNKNOWN_PLAYER' AS player_version_sk,
    'UNKNOWN_PLAYER' AS player_master_sk,
    'UNKNOWN_PLAYER' AS cms_player_id,
    'UNKNOWN_MEMBER' AS member_no,
    'Unknown' AS first_name,
    'Player' AS last_name,
    NULL AS dob,
    NULL AS email,
    'Uncarded' AS tier,
    CAST('1900-01-01' AS TIMESTAMP) AS valid_from_ts,
    CAST('9999-12-31' AS TIMESTAMP) AS valid_to_ts,
    TRUE AS is_current_record
    );
  

        WHEN LOWER(TRIM(last_name)) IN ('', 'n/a', 'na', 'none', 'null', 'undefined', 'unknown') THEN NULL
        ELSE TRIM(last_name)
    END
 AS last_name,
    CAST(dob AS DATE) AS dob,
    CAST(tier AS STRING) AS tier,
    CAST(enroll_date AS DATE) AS enroll_date,
    
    CASE
        WHEN LOWER(TRIM(email)) IN ('', 'n/a', 'na', 'none', 'null', 'undefined', 'unknown') THEN NULL
        ELSE TRIM(email)
    END
 AS email,
    CAST(_loaded_at AS TIMESTAMP) AS source_loaded_at
FROM source;



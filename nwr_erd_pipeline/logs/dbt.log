    WHERE cms_player_id IS NOT NULL
)

SELECT
    to_hex(md5(cast(coalesce(cast(r.rating_id as string), '_dbt_utils_surrogate_key_null_') as string))) AS sk_rating_id,
    r.rating_id,
    i.player_sk,
    r.player_id AS cms_player_id,
    r.rating_score,
    r.rating_ts,
    r._loaded_at AS source_loaded_at
FROM ratings r
LEFT JOIN identities i
    ON r.player_id = i.cms_player_id
    );
  
